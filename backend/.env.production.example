# ============================================================
# CONFIGURATION PRODUCTION — NE JAMAIS COMMITER LE .env RÉEL
# Copier en .env (ou injecter comme variables d'environnement) et remplir.
#
# Il n'y a plus de module `settings_production` : le durcissement s'active
# automatiquement dès que DEBUG=False. L'application REFUSE de démarrer si
# SECRET_KEY, ALLOWED_HOSTS, CORS_ALLOWED_ORIGINS ou REDIS_URL manquent.
# ============================================================

# Générer avec : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Doit faire au moins 50 caractères et ne contenir ni « insecure » ni « remplace ».
SECRET_KEY=REMPLACER_PAR_UNE_CLE_ALEATOIRE_DE_50_CHARS

DEBUG=False

# Uniquement vos domaines réels (obligatoire).
ALLOWED_HOSTS=optilunette.bf,www.optilunette.bf,votre-app.onrender.com

# Origines autorisées à appeler l'API — le domaine du frontend (obligatoire).
CORS_ALLOWED_ORIGINS=https://optilunette.bf,https://www.optilunette.bf
CSRF_TRUSTED_ORIGINS=https://optilunette.bf,https://www.optilunette.bf

# ─── Reverse proxy ───────────────────────────────────────────────────────
# TRUST_PROXY : indispensable derrière Render/Nginx, sinon la redirection HTTPS
# boucle indéfiniment (Django ne voit que du HTTP).
TRUST_PROXY=True
# NUM_PROXIES : nombre de proxys de confiance. Laisser 0 fait reposer les limites
# de débit sur REMOTE_ADDR ; mettre 1 derrière un unique reverse proxy. Une valeur
# trop haute rend les limites contournables via X-Forwarded-For.
NUM_PROXIES=1

# ─── Base de données ─────────────────────────────────────────────────────
DB_NAME=REMPLACER
DB_USER=REMPLACER
DB_PASSWORD=REMPLACER
DB_HOST=REMPLACER.neon.tech
DB_PORT=5432
DB_SSLMODE=require

# ─── Cache partagé (OBLIGATOIRE) ─────────────────────────────────────────
# Sans cache partagé, les compteurs anti-bruteforce sont dupliqués par worker
# et le mode maintenance devient incohérent entre les instances.
REDIS_URL=redis://:motdepasse@hote:6379/0

# ─── Stockage des médias ─────────────────────────────────────────────────
# DEUX buckets distincts et obligatoires :
#  - public  : photos de montures, logos, illustrations (servi par le CDN) ;
#  - privé   : ordonnances = données de santé, accès par URL signée uniquement.
# Le bucket privé NE DOIT PAS avoir de domaine public r2.dev ni d'accès anonyme.
AWS_STORAGE_BUCKET_NAME=lunette-media
AWS_PRIVATE_BUCKET_NAME=lunette-documents-prives
AWS_ACCESS_KEY_ID=REMPLACER
AWS_SECRET_ACCESS_KEY=REMPLACER
AWS_S3_ENDPOINT_URL=https://VOTRE_ACCOUNT_ID.r2.cloudflarestorage.com
AWS_S3_CUSTOM_DOMAIN=pub-xxxxxxxx.r2.dev

# ─── Jetons ──────────────────────────────────────────────────────────────
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=1

# ─── SMS ─────────────────────────────────────────────────────────────────
SMS_PROVIDER=orange
# Préfixes autorisés pour l'envoi d'OTP (protection anti-toll-fraud).
SMS_PREFIXES_AUTORISES=+226,+225,+223,+227,+228,+229
ORANGE_TOKEN_URL=
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_SMS_URL=
ORANGE_SENDER=OptiLunette

# ─── Email ───────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre@email.com
EMAIL_HOST_PASSWORD=MOT_DE_PASSE_APPLICATION_GMAIL
EMAIL_FROM=OptiLunette <votre@email.com>

# ─── IA (OCR ordonnances) ────────────────────────────────────────────────
GROQ_API_KEY=VOTRE_CLE_GROQ

# ─── URLs et OAuth ───────────────────────────────────────────────────────
FRONTEND_URL=https://optilunette.bf
GOOGLE_CLIENT_ID=VOTRE_CLIENT_ID.apps.googleusercontent.com

# ─── Exploitation ────────────────────────────────────────────────────────
DJANGO_LOG_PATH=/var/log/optilunette/django.log
BACKUP_DIR=/var/backups/optilunette/
# Destinataire GPG des sauvegardes. Sans cette valeur, l'endpoint de sauvegarde
# est désactivé : le dump contient les empreintes de mots de passe et les
# données personnelles, il ne doit jamais être écrit en clair.
BACKUP_GPG_RECIPIENT=sauvegardes@optilunette.bf

# Migrations : à lancer explicitement au déploiement, PAS au démarrage des
# conteneurs (deux instances les joueraient en parallèle).
RUN_MIGRATIONS=0
# Ordonnanceur APScheduler : à activer sur UNE SEULE instance, sinon les SMS
# d'anniversaire partent en double (et sont facturés en double).
#
# Sur un hébergement gratuit, laisser 0 : l'instance est mise en veille après
# quelques minutes sans trafic, la tâche horaire ne partirait jamais. Confier la
# planification à un cron externe qui appelle :
#     python manage.py envoyer_anniversaires
RUN_SCHEDULER=0

# Nombre de workers gunicorn. Sur une instance de 512 Mo (offre gratuite), ne
# pas dépasser 1 : deux workers Django plus le décodage d'images de l'essai
# virtuel dépassent la limite et le conteneur est tué (OOM).
GUNICORN_WORKERS=1

# PORT est imposé par la plateforme (Render, Koyeb, Fly) et lu par entrypoint.sh.
# Ne le définir à la main qu'en local. Repli : 8000.
# PORT=8000

# ─── Sonde de vivacité ───────────────────────────────────────────────────
# Configurer la plateforme sur GET /healthz/ — et non sur une route d'API.
# /healthz/ est court-circuité en tête de MIDDLEWARE : il échappe à
# ALLOWED_HOSTS, à la redirection HTTPS et au quota anonyme de 100 requêtes par
# jour, trois causes d'échec d'une sonde interrogée toutes les 30 secondes.

# ─── Interface d'administration ──────────────────────────────────────────
# Chemin non devinable : /admin/ est testé en permanence par les scanners.
ADMIN_URL=gestion-interne-8f3a/
# Liste blanche d'IP. Fortement recommandée : l'admin donne accès à toutes les
# données, ordonnances comprises. Vide = joignable depuis Internet entier.
ADMIN_IPS=
