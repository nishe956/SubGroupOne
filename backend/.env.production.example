# ============================================================
# CONFIGURATION PRODUCTION — NE JAMAIS COMMITER CE FICHIER
# Copier en .env et remplir les vraies valeurs
# ============================================================

# Générer avec : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=REMPLACER_PAR_UNE_CLE_ALEATOIRE_DE_50_CHARS

# OBLIGATOIRE en production
DEBUG=False
DJANGO_ENV=production

# Uniquement vos domaines réels (ajoutez aussi le domaine .onrender.com fourni par Render)
ALLOWED_HOSTS=optilunette.bf,www.optilunette.bf,votre-app.onrender.com

# Origines autorisées à appeler l'API (le domaine Vercel du frontend)
CORS_ALLOWED_ORIGINS=https://votre-app.vercel.app

# Base de données (fournie par Neon, ne pas utiliser localhost en prod)
DB_NAME=REMPLACER
DB_USER=REMPLACER
DB_PASSWORD=REMPLACER
DB_HOST=REMPLACER.neon.tech
DB_PORT=5432

# Stockage des médias (Cloudflare R2, compatible S3) — laisser vide en local
AWS_STORAGE_BUCKET_NAME=lunette-media
AWS_ACCESS_KEY_ID=REMPLACER
AWS_SECRET_ACCESS_KEY=REMPLACER
AWS_S3_ENDPOINT_URL=https://VOTRE_ACCOUNT_ID.r2.cloudflarestorage.com
AWS_S3_CUSTOM_DOMAIN=pub-xxxxxxxx.r2.dev

# SMS : mettre 'orange' ou 'wave' en production (pas 'mock')
SMS_PROVIDER=orange

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre@email.com
EMAIL_HOST_PASSWORD=MOT_DE_PASSE_APPLICATION_GMAIL
EMAIL_FROM=OptiLunette <votre@email.com>

# IA (OCR ordonnances)
GROQ_API_KEY=VOTRE_CLE_GROQ

# URL publique du frontend (utilisée dans les liens envoyés par email)
FRONTEND_URL=https://optilunette.bf

# Client ID OAuth Google (Google Cloud Console > APIs & Services > Identifiants)
GOOGLE_CLIENT_ID=VOTRE_CLIENT_ID.apps.googleusercontent.com

# Logs
DJANGO_LOG_PATH=/var/log/optilunette/django.log
BACKUP_DIR=/var/backups/optilunette/
